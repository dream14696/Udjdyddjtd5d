local FakeCharacter = nil
local FakeHumanoidRootPart = nil

local function createFakeCharacter()
	local char = Player.Character
	if not char then return end

	pcall(function()
		local clone = char:Clone()
		clone.Name = "OP_Adivine_FakeChar"
		
		local hum = clone:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		
		for _, part in ipairs(clone:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
				part.Transparency = 0.3
			end
		end
		
		clone.Parent = workspace
		FakeCharacter = clone
		FakeHumanoidRootPart = clone:FindFirstChild("HumanoidRootPart")
	end)
end

local function removeFakeCharacter()
	if FakeCharacter then
		pcall(function()
			FakeCharacter:Destroy()
		end)
		FakeCharacter = nil
		FakeHumanoidRootPart = nil
	end
end

task.spawn(function()
	while GUI.Parent do
		if AutoJoinActive then
			if not FakeCharacter then
				createFakeCharacter()
			end
			
			for _, coord in ipairs(JoinCoordinates) do
				if not AutoJoinActive then break end
				pcall(function()
					if FakeHumanoidRootPart then
						FakeHumanoidRootPart.CFrame = CFrame.new(coord)
					end
				end)
				task.wait(0.5)
			end
		else
			if FakeCharacter then
				removeFakeCharacter()
			end
			task.wait(0.2)
		end
	end
end)

