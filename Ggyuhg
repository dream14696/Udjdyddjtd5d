MainStroke.Transparency=1

for _,o in ipairs(Main:GetDescendants()) do
	if o:IsA("TextLabel") or o:IsA("TextButton") then
		o.TextTransparency=1

	elseif o:IsA("ImageLabel") then
		o.ImageTransparency=1
	end
end

if Animations then
	tw(Main,1,{
		BackgroundTransparency=.12
	}):Play()

	tw(MainStroke,1,{
		Transparency=0
	}):Play()

	for _,o in ipairs(Main:GetDescendants()) do
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			tw(o,1,{
				TextTransparency=0
			}):Play()

		elseif o:IsA("ImageLabel") then
			tw(o,1,{
				ImageTransparency=0
			}):Play()
		end
	end
else
	Main.BackgroundTransparency=.12
	MainStroke.Transparency=0

	for _,o in ipairs(Main:GetDescendants()) do
		if o:IsA("TextLabel") or o:IsA("TextButton") then
			o.TextTransparency=0

		elseif o:IsA("ImageLabel") then
			o.ImageTransparency=0
		end
	end
end

ApplyTheme()
